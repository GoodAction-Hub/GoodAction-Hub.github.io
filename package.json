    "mobx-restful": "^2.1.4",
    "next": "^16.3.0",
    "open-react-map": "^0.9.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
