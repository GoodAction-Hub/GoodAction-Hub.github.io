    "mobx-react": "^9.2.2",
    "mobx-restful": "^2.1.5",
    "next": "^16.4.3",
    "open-react-map": "^0.9.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
