    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "knip": "^6.43.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.23.0",
    "shadcn-helper": "^0.5.10",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
